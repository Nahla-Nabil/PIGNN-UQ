# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments (this project's venv lives OUTSIDE the repo at
# C:\Users\nahla\venvs\bcpg -- see README.md "Windows long-path note")
.venv/
venv/
env/

# Data: raw rasters/imagery and large downloads are reproducible via
# src/data_pipeline/fetch_*.py + data/README.md -- do not commit them.
data/raw/**
!data/raw/.gitkeep
!data/raw/README.md
# data/processed/graph_{nodes,edges} ARE committed (small, ~1MB each) --
# they're the exact input every results/ metric traces back to
# (see paper/NUMBER_SOURCE_LOG.md), and pinning them means results are
# inspectable without re-running the full data pipeline + graph build.
data/processed/*
!data/processed/.gitkeep
!data/processed/graph_nodes.csv
!data/processed/graph_edges.npy
# journal-extension (post-submission) temporal dC/dt graph -- SEPARATE
# files, built by src/data_pipeline/build_graph_temporal.py; the submitted
# paper's graph_nodes.csv/graph_edges.npy above are never touched by it.
!data/processed/graph_nodes_ext_temporal.csv
!data/processed/graph_edges_ext_temporal.npy

# Keep small provenance/metadata files that are cheap to diff and useful
# to have in history (STAC item index, tide CSVs) -- uncomment if desired:
# !data/raw/sentinel2/*.json
# !data/raw/tides/*.csv

# Experiment outputs
experiments/logs/*
!experiments/logs/.gitkeep
*.ckpt
*.pt
*.pth
# ...except small trained-model checkpoints explicitly saved under
# results/ (same convention as conformal-coverage-geohazard's
# results/*.joblib) -- these are cheap (single trained baseline, ~7KB) and
# make results/ self-contained.
!results/*.pt

# Paper build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
